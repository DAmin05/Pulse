# Copy to .env (`make env`). .env is gitignored — never commit real keys.
# Defaults match deploy/docker-compose.yml; services also fall back to them when unset.

# --- Infrastructure (local dev values) ---
PULSE_KAFKA_BROKERS=localhost:19092
PULSE_DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse
PULSE_S3_ENDPOINT=http://localhost:8333
PULSE_S3_ACCESS_KEY=pulse
PULSE_S3_SECRET_KEY=pulse-dev-secret
PULSE_PROMETHEUS_URL=http://localhost:9090
PULSE_GRAFANA_URL=http://localhost:3000

POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse
POSTGRES_DB=pulse
GRAFANA_ADMIN_PASSWORD=pulse

# --- Metrics ports (scraped by Prometheus via host.docker.internal) ---
PULSE_INGESTOR_METRICS_PORT=9101
PULSE_EMBEDDER_METRICS_PORT=9102
PULSE_PROCESSOR_METRICS_PORT=9103
PULSE_SINK_METRICS_PORT=9104
PULSE_API_PORT=9105

# --- Logging ---
RUST_LOG=info
# PULSE_LOG_FORMAT=json

# --- External APIs (fill in yourself; phase 1 and phase 9) ---
GUARDIAN_API_KEY=
NYT_API_KEY=
DEEPL_API_KEY=
ELEVENLABS_API_KEY=
