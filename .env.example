# Copy to .env (`make env`). .env is gitignored — never commit real keys.
# Defaults match deploy/docker-compose.yml; services also fall back to them when unset.

# --- Infrastructure (local dev values) ---
PULSE_KAFKA_BROKERS=localhost:19092
PULSE_DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse
PULSE_S3_ENDPOINT=http://localhost:8333
PULSE_S3_ACCESS_KEY=pulse
PULSE_S3_SECRET_KEY=pulse-dev-secret
PULSE_PROMETHEUS_URL=http://localhost:9090
PULSE_GRAFANA_URL=http://localhost:3000

POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse
POSTGRES_DB=pulse
GRAFANA_ADMIN_PASSWORD=pulse

# --- Metrics ports (scraped by Prometheus via host.docker.internal) ---
PULSE_INGESTOR_METRICS_PORT=9101
PULSE_EMBEDDER_METRICS_PORT=9102
PULSE_PROCESSOR_METRICS_PORT=9103
PULSE_SINK_METRICS_PORT=9104
PULSE_API_PORT=9105
PULSE_RELAY_METRICS_PORT=9106

# --- Embedder (python -m pulse_embedder) ---
PULSE_EMBEDDER_LISTEN=0.0.0.0:50061
PULSE_EMBEDDER_PRECISION=int8      # fp32 | int8 (see docs/bench/embedder.md)
PULSE_EMBEDDER_MAX_BATCH=64
PULSE_EMBEDDER_MAX_WAIT_MS=5
PULSE_EMBEDDER_MAX_TOKENS=256
PULSE_EMBEDDER_TOKEN_BUDGET=1024   # padded tokens per model call (length bucketing); 0 = off
# PULSE_EMBEDDER_THREADS=0         # 0 = ONNX Runtime default
# PULSE_EMBEDDER_MODEL_DIR=data/models/multilingual-e5-small

# --- Embed relay (articles.raw → articles.embedded) ---
PULSE_EMBEDDER_URL=http://localhost:50061
PULSE_RELAY_MAX_BATCH=256
PULSE_RELAY_LINGER_MS=250
PULSE_RELAY_REQUEST_SIZE=16
PULSE_RELAY_CONCURRENCY=8

# --- Story Processor (articles.embedded → stories.events) ---
PULSE_PROCESSOR_GROUP=story-processor           # also the transactional id base
# PULSE_PROCESSOR_SNAPSHOT_DIR=data/checkpoints/story-processor
PULSE_PROCESSOR_SNAPSHOT_EVERY_MESSAGES=5000
PULSE_PROCESSOR_SNAPSHOT_EVERY_SECS=300
PULSE_PROCESSOR_KEEP_SNAPSHOTS=5
PULSE_PROCESSOR_MAX_BATCH=500                   # inputs per transaction
PULSE_PROCESSOR_LINGER_MS=200
# PULSE_CENTERING=config/centering/<model>.json # default: derived from model version

# --- Story Sink (→ Postgres read model) ---
PULSE_SINK_MAX_BATCH=1000
PULSE_SINK_LINGER_MS=100

# --- Query API (REST + SSE + /metrics on PULSE_API_PORT) ---
# PULSE_SOURCES=config/sources.toml

# --- Logging ---
RUST_LOG=info
# PULSE_LOG_FORMAT=json

# --- Listen: briefings translated and read aloud (Query API) ---
# Without keys, briefings use coverage already in the chosen language and the
# browser's own voice reads them. DeepL Free keys end in ":fx".
# PULSE_TTS_MODEL=eleven_flash_v2_5     # 32 languages; half the credits of eleven_multilingual_v2
# PULSE_TTS_MODEL_WIDE=eleven_v3        # 70+ languages, for the ones the first model doesn't speak
# PULSE_TTS_VOICE=JBFqnCBsd6RMkjVDRZzb  # default voice (George)
# PULSE_TTS_DAILY_CHARS=3000            # speech budget per UTC day (cached replays are free)
# PULSE_TRANSLATE_MONTHLY_CHARS=400000  # DeepL Free allows 500k a month
# PULSE_BRIEFING_MAX_CHARS=520          # about 30 seconds of speech
# PULSE_AUDIO_STORE=s3                  # s3 (bucket PULSE_AUDIO_BUCKET=pulse-audio) | local (PULSE_AUDIO_DIR=data/audio)
# PULSE_LIBRETRANSLATE_URL=             # self-hosted alternative, used when DEEPL_API_KEY is empty

# --- Listen API keys (optional; see the README) ---
DEEPL_API_KEY=
ELEVENLABS_API_KEY=
